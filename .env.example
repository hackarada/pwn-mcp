# Copy to .env and adjust. Used by docker compose.

# MCP HTTP listen (host publish port)
PWN_MCP_PORT=8000

# Optional shared bearer token for remote clients:
# Authorization: Bearer <token>
# PWN_MCP_AUTH_TOKEN=change-me

# Scope enforcement (uncomment both to enable):
# PWN_MCP_SCOPE=/data/scope.txt
# PWN_MCP_SCOPE_FILE=./scope.txt

# Auto-start embedded mitmproxy inside the container:
# PWN_MCP_PROXY_PORT=8080
# PWN_MCP_PROXY_HOST=0.0.0.0
# PWN_MCP_PROXY_PUBLISH=8080

# Optional Playwright MCP sidecar (browser_* tools for SPA DOM / JS).
# Requires compose profile "browser" and a listening mitmproxy
# (PWN_MCP_PROXY_PORT). The entrypoint waits for the sidecar, then refuses
# to start browser mode if the proxy port is unset.
#   docker compose --profile browser up -d --build
# PWN_MCP_BROWSER=1
# PWN_MCP_BROWSER_URL=http://playwright:8931/mcp
# Chromium outbound proxy (compose DNS — not 127.0.0.1):
# PWN_MCP_BROWSER_PROXY=http://pwn-mcp:8080
# PWN_MCP_PROXY_PORT=8080

# ProjectDiscovery tools (subfinder + nuclei) are included by default.
# Set false for a leaner image (rebuild required):
# INSTALL_PD_TOOLS=false

# Refresh nuclei templates on every container start (default true).
# Set false for air-gapped hosts or faster cold starts:
# PWN_MCP_UPDATE_NUCLEI_TEMPLATES=false

# PostgreSQL (job store). Compose defaults to the sibling postgres service.
# DATABASE_URL=postgres://pwn:pwn@postgres:5432/pwn_mcp?sslmode=disable
# POSTGRES_USER=pwn
# POSTGRES_PASSWORD=pwn
# POSTGRES_DB=pwn_mcp
# Local tools / dbmate (host):
# DATABASE_URL=postgres://pwn:pwn@127.0.0.1:5432/pwn_mcp?sslmode=disable
