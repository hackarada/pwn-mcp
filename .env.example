# Copy to .env and adjust. Used by docker compose.

# MCP HTTP listen (host publish port)
PWN_MCP_PORT=8000

# Optional shared bearer token for remote clients:
# Authorization: Bearer <token>
# PWN_MCP_AUTH_TOKEN=change-me

# Scope enforcement (uncomment both to enable):
# PWN_MCP_SCOPE=/data/scope.txt
# PWN_MCP_SCOPE_FILE=./scope.txt

# Auto-start embedded mitmproxy inside the container:
# PWN_MCP_PROXY_PORT=8080
# PWN_MCP_PROXY_HOST=0.0.0.0
# PWN_MCP_PROXY_PUBLISH=8080

# ProjectDiscovery tools (subfinder + nuclei) are included by default.
# Set false for a leaner image (rebuild required):
# INSTALL_PD_TOOLS=false

# Refresh nuclei templates on every container start (default true).
# Set false for air-gapped hosts or faster cold starts:
# PWN_MCP_UPDATE_NUCLEI_TEMPLATES=false
